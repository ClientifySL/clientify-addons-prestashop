# .env.local.example — TEMPLATE de credenciales compartidas.
# Este archivo SI se versiona (no lleva secretos).
#
# Este repo COMPARTE canal Slack y DB de Notion con clientify_new_python3 (backend Django).
# Lo mas facil: copia los MISMOS valores reales que ya tienes en
#   clientify_new_python3\clientify.net\clientify\.env.local
# a este archivo (renombrado .env.local) en la raiz de ESTE repo:
#   modules\clientify\.env.local
#
# El loader (.claude/scripts/_env.py) busca .env.local subiendo desde el directorio
# donde se ejecuta el comando hasta la raiz — ponlo en la raiz del repo del modulo.

# ─── Slack — bot "Clientify Releases" ───
# Mismo bot/canal que usa el backend: #releases-info
SLACK_BOT_TOKEN=xoxb-XXXX-XXXX-XXXX
SLACK_RELEASES_CHANNEL_ID=CXXXXXXXXXX

# ─── Notion — Internal Integration "Releases Announcer" ───
# Misma DB "Product Releases" que usa el backend. Los releases de este plugin
# apareceran junto a los del backend, distinguibles por la columna Repo = "prestashop".
NOTION_TOKEN=secret_XXXXXXXXXXXXXXXX
NOTION_RELEASES_DB_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── SMTP — digest semanal (viernes) ───
# Mismas credenciales que el backend; el digest lo sigue enviando el mismo responsable
# desde el repo de clientify_new_python3 (/send-digest), no hace falta duplicarlo aqui.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=releases@clientify.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_DIGEST_TO=team@clientify.com

# ─── Anthropic ───
# NO se usa. El copy comercial lo genera Claude Code en sesion activa cuando el
# dev lanza /announce-change. Sin coste extra.
